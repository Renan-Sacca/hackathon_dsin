# ==========================================
# PROMETHEUS — F.O.G.O. Environment Variables (Example)
# ==========================================

PROJECT_NAME="PROMETHEUS — F.O.G.O."
VERSION="1.0.0"
ENVIRONMENT="development"

# Security & JWT
SECRET_KEY="change_this_to_a_random_secure_secret_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./prometheus.db"

# Default Admin Credentials
DEFAULT_ADMIN_NAME="Administrador PROMETHEUS"
DEFAULT_ADMIN_EMAIL="admin@prometheus.gov"
DEFAULT_ADMIN_PASSWORD="admin123"
