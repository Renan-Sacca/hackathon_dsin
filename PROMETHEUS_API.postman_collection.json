                "exec": [
                  "pm.test('Status code 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna analise geoespacial com score de risco', function () {",
                  "    var data = pm.response.json();",
                  "    pm.expect(data).to.be.an('array');",
                  "    if (data.length > 0) {",
                  "        pm.expect(data[0]).to.have.property('score_risco');",
                  "        pm.expect(data[0]).to.have.property('explicacao');",
                  "    }",
                  "});"
